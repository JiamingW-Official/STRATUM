node_modules/
dist/
.DS_Store
.vercel
# public/radio was ignored back when the tracks were 90MB of 128k MP3. They are
# 70MB of AAC now and the app cannot run without them, so they belong in the
# repo: a fresh clone had no radio at all. dist/ is still ignored, so the built
# copy does not double the weight. No rule here excludes it any more.
scripts/

# Cloud-drive sync-conflict copies ("NAME 2.ext"); never referenced, bodies often not on disk.
* [0-9].*

# Playwright run artifacts (traces, failure screenshots). tests/baseline/ is the
# only image that is reviewed and committed.
test-results/
playwright-report/

# Wrangler's local state directory.
.wrangler/

# Raw audio the radio tracks are encoded from (1.4 GB). public/radio holds the
# encoded AAC the app actually serves; the sources belong outside git.
/radio/

# Cloud-drive sync-conflict copy with no extension; the rule above only
# catches "NAME 2.ext".
public/_headers 2

# Generated and raw artwork. The brief's rule: large files do not enter git,
# and anything that has to be online goes to R2. /assets/raw/ is where a
# Midjourney download lands before it is cut, cropped and exported; only the
# small, optimised export belongs in the repo, and only when something in the
# app actually references it.
/assets/raw/
*.blend
*.blend1
