    { "source": "/api/weather", "destination": "https://stratum.jiamingwofficial.workers.dev/api/weather" },
    { "source": "/api/atlas", "destination": "https://stratum.jiamingwofficial.workers.dev/api/atlas" },
    { "source": "/api/airports", "destination": "https://stratum.jiamingwofficial.workers.dev/api/airports" },
